<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp">
    <TextView android:id="@+id/item_com_autor" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <TextView android:id="@+id/item_com_fecha" android:textSize="10sp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <TextView android:id="@+id/item_com_texto" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="4dp" />
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#DDD" android:layout_marginTop="8dp"/>
</LinearLayout>